{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "泊影 Framemoor",
  "version": "0.2.0",
  "identifier": "dev.cardingest.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "main", "title": "泊影 Framemoor", "width": 1280, "height": 860, "minWidth": 1000, "minHeight": 700, "center": true, "backgroundColor": "#f7f8fa" }],
    "security": { "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true, "targets": ["app", "dmg"], "category": "Photography",
    "shortDescription": "Verified photo and video ingest",
    "resources": { "resources/exiftool/": "exiftool/", "resources/notices/": "notices/" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "13.0", "signingIdentity": "-" }
  }
}
